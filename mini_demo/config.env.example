# Default inference endpoint for Kimi-K3 and GLM-5.2.
export INFER_API_KEY='<SCNet inference API key>'
export INFER_BASE_URL='https://api.scnet.cn/api/llm/v1'

# Per-model inference override for deepseek-v4-flash.
export DEEPSEEK_V4_FLASH_INFER_API_KEY='<DeepSeek inference API key>'
export DEEPSEEK_V4_FLASH_INFER_BASE_URL='https://api.deepseek.com/chat/completions'

# Fixed Judge endpoint used by every judged task.
export JUDGE_API_KEY='<SCNet Judge API key>'
